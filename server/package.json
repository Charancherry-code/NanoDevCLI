{
  "name": "nano-dev",
  "version": "0.1.2",
  "description": "A minimal CLI AI coding agent: type a task in plain English and it reads, writes, and runs code by letting an LLM call tools in a loop.",
  "type": "module",
  "bin": {
    "nano-dev": "bin/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/index.js",
    "agent": "node bin/index.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "llm",
    "agent",
    "function-calling"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charancherry-code/NanoDevCLI.git",
    "directory": "server"
  },
  "homepage": "https://github.com/Charancherry-code/NanoDevCLI#readme",
  "bugs": {
    "url": "https://github.com/Charancherry-code/NanoDevCLI/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "openai": "^6.41.0",
    "ora": "^9.4.0"
  }
}
